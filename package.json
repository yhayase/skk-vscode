  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "package-web": "webpack --mode production --devtool hidden-source-map",
    "build": "rm -rf ./out ./dist && tsc --project tsconfig.build.json && npm run package-web",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "npm run test:unit && npm run test:integration && npm run test:web",
    "test:unit": "npm run pretest && mocha -R dot",
    "test:integration": "npm run pretest && node ./out/test/integration/runTest.js",
    "pretest:web": "npm run compile-web",
    "test:web": "vscode-test-web --browserType=chromium --extensionDevelopmentPath=. --extensionTestsPath=dist/web/test/suite/index.js",
    "package": "vsce package",
    "check:branch": "node -e \"if (require('child_process').execSync('git rev-parse --abbrev-ref HEAD').toString().trim() !== 'main') { console.error('Error: Release commands must be run on the main branch.'); process.exit(1); }\"",
    "release:patch": "npm run check:branch && npm test && vsce publish patch && git push origin main --follow-tags",
    "release:minor": "npm run check:branch && npm test && vsce publish minor && git push origin main --follow-tags",
    "release:major": "npm run check:branch && npm test && vsce publish major && git push origin main --follow-tags"
  },
